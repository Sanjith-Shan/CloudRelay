{
  "uid": "cloudrelay-main",
  "title": "CloudRelay: service, matchmaking and analytics tee",
  "tags": [
    "cloudrelay",
    "gaming",
    "sessions"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Sessions",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "cloudrelay_sessions_active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players Connected",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "cloudrelay_players_connected",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sessions Created per Minute",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(cloudrelay_sessions_created_total[1m]) * 60",
          "refId": "A",
          "legendFormat": "created/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Session Join Latency (p50 / p95 / p99)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(cloudrelay_session_join_latency_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(cloudrelay_session_join_latency_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cloudrelay_session_join_latency_seconds_bucket[5m]))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate by Endpoint",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/v1/.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "heap used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Latency p95 by Endpoint",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/.*\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Matchmaking: rating spread within formed parties",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cloudrelay_matchmaking_rating_spread_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": null
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cloudrelay_matchmaking_rating_spread_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": null
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Gap between the strongest and weakest player in a party. This is match quality: lower is a more even game. Read it next to the wait time panel, never on its own \u2014 tightening the search window improves this and lengthens queues, and watching only this is how a matchmaker gets tuned into producing fast, terrible games."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Matchmaking: how long the anchor player waited",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cloudrelay_matchmaking_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": null
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cloudrelay_matchmaking_wait_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": null
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The price paid for the rating spread above. The search window widens with waiting, so these two move together."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Matchmaking: parties formed vs attempts that found nobody",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "sum(rate(cloudrelay_matchmaking_parties_formed_total[5m])) * 60",
          "legendFormat": "parties formed / min",
          "refId": "A",
          "datasource": null
        },
        {
          "expr": "sum(rate(cloudrelay_matchmaking_attempts_unfilled_total[5m])) * 60",
          "legendFormat": "unfilled attempts / min",
          "refId": "B",
          "datasource": null
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Unfilled attempts are normal, not errors: there were not yet enough compatible players and everyone stayed queued with a wider window. A sustained ratio near 100% unfilled means the game is genuinely short of players."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Analytics tee: events reaching Kafka, and events shed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "sum(rate(cloudrelay_analytics_events_published_total[5m])) * 60",
          "legendFormat": "published / min",
          "refId": "A",
          "datasource": null
        },
        {
          "expr": "sum(rate(cloudrelay_analytics_events_failed_total[5m])) * 60",
          "legendFormat": "failed / min",
          "refId": "B",
          "datasource": null
        },
        {
          "expr": "sum(rate(cloudrelay_analytics_events_dropped_total[5m])) * 60",
          "legendFormat": "dropped by backpressure / min",
          "refId": "C",
          "datasource": null
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Dropped or failed events mean the lakehouse is missing data. The tee is designed to shed rather than block, so this rising is the only signal that it happened \u2014 session traffic is deliberately unaffected."
    }
  ]
}