<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cloudrelay</groupId>
    <artifactId>cloudrelay-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>cloudrelay-parent</name>
    <description>Real-time cloud gaming session orchestration with a streaming lakehouse</description>

    <modules>
        <module>cloudrelay-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Lakehouse stack. Spark 3.5.x is the last line with clean Java 17
             support; delta-spark 3.2.0 and spark-sql-kafka must match it exactly. -->
        <spark.version>3.5.1</spark.version>
        <scala.binary.version>2.12</scala.binary.version>
        <delta.version>3.2.0</delta.version>
        <testcontainers.version>1.21.3</testcontainers.version>

        <!--
          Docker's API version, pinned for Testcontainers.

          docker-java negotiates 1.32 by default. Docker Engine 29 dropped
          everything below 1.40, so on an up to date Docker Desktop every
          container start fails with "Could not find a valid Docker environment"
          and a 400 that names none of this. Pinning a version both old and new
          daemons accept is the fix. Override with -Ddocker.api.version= if a
          particular machine needs something else.
        -->
        <docker.api.version>1.44</docker.api.version>

        <!--
          Lets CI split unit tests and integration tests into separate jobs.
          -DskipUTs=true runs only the Testcontainers suites; -DskipITs=true is
          failsafe's own flag and runs only the fast ones. Worth the two
          properties: the unit suites finish in a couple of minutes and the
          integration ones need Docker, so a failure in one should not be
          waiting behind the other.

          skipUTs defaults to skipTests rather than to false, and that
          indirection is load bearing. Surefire's skipTests parameter is bound
          to the -DskipTests user property by default; writing
          <skipTests>${skipUTs}</skipTests> in the plugin config replaces that
          binding, so plain -DskipTests silently stops working. It is a common
          enough command that the Docker build uses it, and the failure mode is
          an image build running the test suite against databases that are not
          there. Chaining the default here keeps -DskipTests, -DskipUTs and
          -DskipITs all behaving the way somebody would expect.
        -->
        <skipTests>false</skipTests>
        <skipUTs>${skipTests}</skipUTs>
    </properties>
</project>
